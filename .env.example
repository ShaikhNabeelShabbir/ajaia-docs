# Browser-safe (bundled into the frontend). Find both in Supabase → Project Settings → API Keys.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   # or the legacy "anon" key

# OPTIONAL SECRET — only for `npm run test:integration`. Never prefix with VITE_.
SUPABASE_SECRET_KEY=sb_secret_...                  # or the legacy "service_role" key
