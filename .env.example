# Copy to .env.local (gitignored) and fill in. See README → "Environment variables".
#
# Rule of thumb: only VITE_* variables reach the browser, and the build refuses to run if a
# VITE_* variable holds a database URL or secret key.

# ---------------------------------------------------------------------------
# App — needed locally AND in production (Vercel). Public by design: safe in the browser
# because every table is protected by Row Level Security.
# Supabase → Project Settings → API Keys.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   # or the legacy "anon" key

# ---------------------------------------------------------------------------
# Database setup — LOCAL ONLY, TEMPORARY. Used by `npm run db:push` to apply supabase/migrations.
# Full-privilege credential (bypasses RLS):
#   - never prefix with VITE_
#   - never add to Vercel or any production environment
#   - delete this line once the schema is applied (the app never needs it)
# Supabase → Connect → "Session pooler" (or the transaction pooler; db:push switches it to session mode).
# Special characters in the password are URL-encoded for you.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# OPTIONAL, LOCAL ONLY — only for `npm run test:integration`. Bypasses RLS: never VITE_, never Vercel.
# ---------------------------------------------------------------------------
